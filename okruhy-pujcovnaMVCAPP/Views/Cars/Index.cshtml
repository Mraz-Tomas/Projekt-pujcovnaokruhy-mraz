@model List<okruhy_pujcovnaMVCAPP.Entities.car>
@{
    ViewData["Title"] = "Auta";
}

<style>
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(290px,1fr));
        gap: 18px;
        margin-top: 14px;
    }

    .cardx {
        border-radius: 18px;
        overflow: hidden;
        background: #fff;
        border: 1px solid rgba(0,0,0,.06);
        box-shadow: 0 12px 26px rgba(0,0,0,.08);
        transition: .25s;
    }

        .cardx:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 34px rgba(0,0,0,.12);
        }

    .imgx {
        height: 170px;
        overflow: hidden;
    }

        .imgx img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .pad {
        padding: 14px;
    }

    .muted {
        color: #6b7280;
    }

    .actions {
        display: flex;
        gap: 10px;
        margin-top: 12px;
        flex-wrap: wrap;
    }

    .btnx {
        padding: 9px 12px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 900;
        border: 1px solid rgba(0,0,0,.12);
        color: #111;
        background: #fff;
    }

        .btnx.dark {
            background: #111;
            color: #fff;
            border-color: #111;
        }

        .btnx:hover {
            opacity: .92;
        }

    .toprow {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 22px;
    }
</style>

<div class="toprow">
    <div>
        <h1>Auta</h1>
        <div class="muted">Správa aut</div>
    </div>
    <a class="btnx dark" href="/Cars/Create">+ Přidat auto</a>
</div>

<div class="grid">
    @foreach (var car in Model)
    {
        <div class="cardx">
            <div class="imgx">
                <img src="/images/cars/car_@(car.car_id).jpg"
                     onerror="this.onerror=null;this.src='/images/placeholder.jpg';"
                     alt="Auto" />
            </div>
            <div class="pad">
                <div style="font-weight:900;font-size:18px;">@car.brand @car.model</div>
                <div class="muted">⚡ @car.power_hp HP</div>
                <div class="muted">💸 @car.price_per_day Kč / den</div>

                <div class="actions">
                    <a class="btnx dark" href="/Cars/Detail/@car.car_id">Detail</a>
                    <a class="btnx" href="/Cars/Edit/@car.car_id">Upravit</a>
                    <a class="btnx" href="/Cars/Delete/@car.car_id">Smazat</a>
                </div>
            </div>
        </div>
    }
</div>
