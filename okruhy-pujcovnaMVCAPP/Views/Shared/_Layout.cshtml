<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TrackRent</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <header class="topbar">
        <div class="topbar-inner">

            <a href="/" class="brand">
                <img src="/images/logo.png" alt="TrackRent" />
                <span>TrackRent</span>
            </a>

            <nav class="menu">
                <a href="/">Domů</a>
                <a href="/Cars">Auta</a>
                <a href="/Circuits">Okruhy</a>
            </nav>

            <div class="auth">
                @if (User?.Identity != null && User.Identity.IsAuthenticated)
                {
                    <span class="user">👤 @User.Identity.Name</span>
                    <a href="/User/Logout" class="btn outline">Odhlásit</a>
                }
                else
                {
                    <a href="/User/Login" class="btn dark">Přihlásit se</a>
                }
            </div>

        </div>
    </header>

    <main class="app-container">
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="app-container footer-inner">
            <div>© @DateTime.Now.Year TrackRent</div>
            <div class="muted">Půjčovna aut na okruhy</div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
