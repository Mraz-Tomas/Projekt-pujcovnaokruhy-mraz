@{
    ViewData["Title"] = "Přidat okruh";
}

<h1>Přidat okruh</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Název okruhu</label>
        <input class="form-control" name="name" />
    </div>

    <div class="mb-3">
        <label class="form-label">Země</label>
        <input class="form-control" name="country" />
    </div>

    <div class="mb-3">
        <label class="form-label">Délka (km)</label>
        <input class="form-control" name="lenghtKm" />
        <small class="text-muted">Např. 5.3 nebo 5,3</small>
    </div>

    <button class="btn btn-dark">Uložit</button>
    <a class="btn btn-link" href="/Circuits">Zpět</a>
</form>
